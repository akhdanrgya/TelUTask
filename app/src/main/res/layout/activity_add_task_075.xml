<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_069"
    tools:context=".task.AddTaskActivity075">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="24dp">
    <TextView
        android:id="@+id/tvHeaderTitle075"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ui_copy_14_069"
        android:textColor="@color/dark_text_069"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvHeaderSubtitle075"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ui_copy_15_069"
        android:textColor="@color/gray_text_069"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle075" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNamaTugas075"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/ui_copy_16_069"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderSubtitle075"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">
      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etNamaTugas075"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="textCapSentences"
          android:maxLines="2" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/tvLabelPrioritas075"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ui_copy_17_069"
        android:textColor="@color/dark_text_069"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilNamaTugas075" />
    <Spinner
        android:id="@+id/spinnerPrioritas075"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/spinner_069"
        android:spinnerMode="dropdown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLabelPrioritas075" />
    <TextView
        android:id="@+id/tvLabelDeadline075"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ui_copy_18_069"
        android:textColor="@color/dark_text_069"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinnerPrioritas075" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectDeadline075"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ui_copy_19_069"
        android:textAllCaps="false"
        app:icon="@drawable/calendar_069"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLabelDeadline075" />
    <TextView
        android:id="@+id/tvSelectedDeadline075"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ui_copy_20_069"
        android:textColor="@color/gray_text_069"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSelectDeadline075" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpan075"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingVertical="12dp"
        android:text="@string/ui_copy_21_069"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSelectedDeadline075" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBatal075"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ui_copy_22_069"
        android:textAllCaps="false"
        android:textColor="@color/gray_text_069"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSimpan075" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
